# MongoDB Atlas (use a London / eu-west-2 cluster). Atlas is a replica set, so transactions work.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/dk_crm?retryWrites=true&w=majority"
# Optional: database name if it is not in the URI
MONGODB_DB=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL. Needed locally and for a custom domain; *.vercel.app URLs are trusted automatically.
BETTER_AUTH_URL=http://localhost:3000

# Optional: "Sign in with Microsoft" (Entra ID app registration). Users must already exist in the CRM.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Vercel Blob store for quotes, drawings and photos (created from the Vercel dashboard → Storage).
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/daily (Vercel sends it automatically) and is the code for the one-time /setup page.
CRON_SECRET=

# Comma-separated origins allowed to post to /api/enquiries, e.g. https://www.dkliftservices.co.uk
ENQUIRY_ALLOWED_ORIGINS=

# Used by `npm run db:setup` to create the first administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Managing Director"
